<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

      <record id="acanto_view_move_form" model="ir.ui.view">
          <field name="name">acanto.account.move.form</field>
          <field name="model">account.move</field>
          <field name="inherit_id" ref="account.view_move_form"/>
          <field name="arch" type="xml">
              <group id="header_right_group" position="inside">
                  <field name="factura_cf" readonly="state != 'draft'"/>
              </group>
              <page name="other_info" position = "after">
                <page name="contra_pago" string="Contraseña de pago">
                   <group>
                      <field name="fecha_receptionPago"/>
                      <field name="fecha_pago"/>
                   </group>
                 </page>
              </page>
          </field>
      </record>

    <record id="view_acanto_productos_vendidos_move_line_tree" model="ir.ui.view">
        <field name="name">acanto.productos.account.move.line.tree</field>
        <field name="model">account.move.line</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="date"/>
                <field name="move_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="discounted_product"/>
                <field name="discount"/>
                <field name="price_unit"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>
        
    <record id="account_view_move_form_discounted_inherit" model="ir.ui.view">
        <field name="name">account.view.move.form.discounted.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_uom_id']" position="before">
                <field name="discounted_product"/>
            </xpath>
        </field>
    </record>

    </data>
</odoo>
