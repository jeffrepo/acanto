<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="acanto_crm_lead_inherit_crm_extended" model="ir.ui.view">
            <field name="name">acanto.crm.lead.view.form.inherit.crm.extended</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <button name="action_set_won_rainbowman" position="after">
                    <button name="open_sale_product_wizard" type="object" string="Productos vendidos"/>
                </button>
                <xpath expr="//field[@name='user_id']" position="after">
                        <label for="saldo"/>
                        <div class="o_row">
                            <button name="open_action_followup" type="object" string="Info"/>
                            <field name="saldo"/>
                        </div>
                        <label for="plazo_pago"/>
                        <div class="o_row o_row_readonly">
                            <field name="plazo_pago"/>
                        </div>
                        <label for="company_id"/>
                        <div class="o_row o_row_readonly">
                            <field name="company_id"/>
                        </div>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="attributes">
                        <attribute name="groups">acanto.cliente_lead</attribute>
                </xpath>
                <xpath expr="//button[@name='action_sale_quotations_new']" position="replace">
                    <button string="Crear cotización" name="action_sale_quotations_new" type="object" class="oe_highlight" data-hotkey="q"
                        title="Create new quotation"
                        invisible="probability == 0 and not active"/>
               </xpath>
                <!-- <xpath expr="//page[@name='extra']" position="after">
                    <page string="Productos vendidos" name="productos_vendidos">
                        <group>
                            <field name="fecha_inicio"/>
                            <field name="fecha_final"/>
                            <field name="productos_vendidos_ids">
                                <tree editable="bottom">
                                    <field name="date"/>
                                    <field name="move_id"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="company_id"/>
                                 </tree>
                            </field>
                        </group>
                    </page>
                </xpath> -->
            </field>
        </record>

    </data>
</odoo>
