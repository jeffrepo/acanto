<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inherit_form_view_res_partner_acanto" model="ir.ui.view">
        <field name="name">Herencia de vista Formulario de Contacto para logística</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website']" position="after">
                <field name="ref"/>
            </xpath>
            <field name="vat" position="after">
                <field name="visitas"/>
                <field name="observaciones"/>
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="acanto_res_partner_view_form">
        <field name="name">acanto.res.partner.view.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account_followup.res_partner_view_form"/>
        <field name="arch" type="xml">
            
            <button name="open_action_followup" position="attributes">
                <!-- <button groups="sales_team.group_sale_salesman" type="object" class="oe_stat_button" name="open_action_followup" icon="fa-list" invisible="total_due == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="total_due" widget='monetary' options="{'currency_field': 'currency_id'}"/></span>
                        <span class="o_stat_text">Due</span>
                    </div>
                    </button> -->
                 <attribute name="groups">sales_team.group_sale_salesman</attribute>
            </button>
        </field>
    </record>
    
</odoo>
